{
  "name": "barbieriapp",
  "version": "0.1.0",
  "private": true,
"scripts": {
  "dev": "next dev --port 3000",
  "dev:clean": "npm run dev",
  "build": "next build",
  "start": "next start --port 3000",
  "start:clean": "npm run start",
  "api": "npm --prefix barbieri_api run start",
  "dev:api": "npm --prefix barbieri_api run dev",
  "dev:all": "concurrently \"npm --prefix barbieri_api run start\" \"next dev --port 3000\"",
  "start:all": "concurrently \"npm --prefix barbieri_api run start\" \"next start --port 3000\"",
  "electron": "electron .",
  "dev-electron": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
  "start-electron": "concurrently \"npm run start\" \"wait-on http://localhost:3000 && electron .\"",
  "dist": "npm run build && electron-builder"
},
"main": "main.js",

"build": {
  "appId": "com.barbieri.app",
  "productName": "BarbieriApp",
  "files": [
    ".next/**/*",
    "public/**/*",
    "main.js",
    "package.json",
    "node_modules/**/*"
  ],
  "win": {
    "target": "nsis"
  }
},
  "dependencies": {
    "@react-pdf/renderer": "^4.3.0",
    "axios": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.22.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mysql2": "^3.14.1",
    "next": "^16.2.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "description": "This is a [Next.js](https://nextjs.org) project bootstrapped with [`create-next-app`](https://nextjs.org/docs/app/api-reference/cli/create-next-app).",
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenriqueMNH/barbieriapp2.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/HenriqueMNH/barbieriapp2/issues"
  },
  "homepage": "https://github.com/HenriqueMNH/barbieriapp2#readme",
  "devDependencies": {
    "concurrently": "^10.0.0",
    "electron": "^40.10.2",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.10",
    "wait-on": "^9.0.10"
  }
}
